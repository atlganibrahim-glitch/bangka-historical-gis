# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env

# QGIS & GIS temporary files
*.qgz~
*.qgs~
*.log
*.tmp
*.bak

# Large raw scan and output directories (hosted on Zenodo/HuggingFace due to GitHub size limits)
main maps/
recovered_maps/
CROP_TEST/
CROP_TEST2/
GEOREF_NEATLINE/
GEOREF_GRID/
GEOREF_FINAL/
GEOREF_FINAL_STANDARD_164/
GEOREF_FINAL_COMPOSITE_12/
GEOREF_V3/
GEOREF_V3_1/
CORRECTED_MAPS/
new_crop_maps.zip
new_crops/

# Large regenerable caches (see v3/ scripts to rebuild)
v3/osm_roads.json

# Local-machine QGIS convenience files - the .vrt files bake in absolute
# paths, so they only work on this checkout; the .geojson layers are
# portable and are tracked.
qgis/*.vrt

# Personal / private notes, not part of the published dataset
EMAIL_DRAFT.md
QGIS_KONTROL.md

# Leftover git-recovery backup directory, not repo content
.git-backup/


# Raster outputs (global rule to prevent any large TIF from leaking into repo)
*.tif
*.tif.aux.xml

# Backup CSVs
*_backup.csv

# Claude session files
.claude/

# Office temporary / lock files
~$*
*.~*

# Figure tile cache (regenerable; fetched by v3/make_figures.py)
v3/tilecache/

# Landsat scenes fetched by v3/landsat_coast.py (regenerable from the STAC API)
v3/landsat/

# SQLite journal files - present only while QGIS holds a GeoPackage open
*.gpkg-shm
*.gpkg-wal

# Superseded by control_points.gpkg; QGIS could not reliably commit edits to a
# GeoJSON in place, which is why the control points live in a GeoPackage.
qgis/control_points.geojson
